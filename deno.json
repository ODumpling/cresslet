{
  "tasks": {
    "dev": "deno run --allow-all --watch=server/,runtime/ server/main.ts",
    "start": "deno run --allow-all server/main.ts",
    "test": "deno test --allow-all tests/",
    "vendor": "deno run --allow-all scripts/vendor-container.ts",
    "check": "deno check server/main.ts runtime/runner.ts"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.7.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/http": "jsr:@std/http@^1.1.4",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0"
  },
  "fmt": { "lineWidth": 100 },
  "exclude": ["data/", "studio/vendor/", "templates/"]
}
