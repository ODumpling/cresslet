# Read by docker compose (deploy/compose.yaml). DNS credentials go in caddy.env, server settings in cresslet.env.
CRESSLET_DOMAIN=cresslet.example.com
# Another DNS provider than Cloudflare: its github.com/caddy-dns/* module (then edit caddy/dns.caddy).
# CADDY_DNS_MODULE=github.com/caddy-dns/route53
