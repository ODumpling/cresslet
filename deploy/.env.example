# Read by docker compose (deploy/compose.yaml). Server settings go in cresslet.env.
CRESSLET_DOMAIN=cresslet.example.com
# DNS-01 for the wildcard cert. Cloudflare API token: Zone → Zone → Read and Zone → DNS → Edit on that zone.
CLOUDFLARE_API_TOKEN=
# Another DNS provider: its github.com/caddy-dns/* module, edit caddy/dns.caddy, credentials in caddy.env.
# CADDY_DNS_MODULE=github.com/caddy-dns/route53
