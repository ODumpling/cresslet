# Read by docker compose (deploy/compose.yaml). Server settings go in cresslet.env.
CRESSLET_DOMAIN=cresslet.example.com
# DNS-01 for the wildcard cert. Cloudflare token: Zone.DNS edit on that zone.
CLOUDFLARE_API_TOKEN=
# Another DNS provider: its github.com/caddy-dns/* module, and edit caddy/dns.caddy.
# CADDY_DNS_MODULE=github.com/caddy-dns/route53
