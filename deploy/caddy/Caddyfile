# Caddy in front of cresslet (see docs/self-hosting.md#production).
# Root and `*.<domain>` (apps, preview host): a cert each via ACME DNS-01.
# Custom domains: on-demand certs, only for names the control plane approves.
{
	import options.caddy
	on_demand_tls {
		ask http://cresslet:8787/v1/domains/check
	}
}

# The client's address for the per-IP limits (CRESSLET_CLIENT_IP_HEADER in compose.yaml), always
# overwritten, so a client can't send its own.
(client_ip) {
	header_up X-Cresslet-Client-Ip {remote_host}
}

{$CRESSLET_DOMAIN}, *.{$CRESSLET_DOMAIN} {
	tls {
		import dns.caddy
	}
	reverse_proxy cresslet:8787 {
		import client_ip
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy cresslet:8787 {
		import client_ip
	}
}
