{
  "name": "cresslet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=runtime server/main.ts",
    "start": "node server/main.ts",
    "test": "node --test --test-concurrency=1 \"tests/*_test.ts\"",
    "check": "tsc --noEmit && tsc -p studio && tsc -p studio/tsconfig.worker.json && tsc -p studio/tsconfig.service.json && tsc -p runtime",
    "vendor": "node scripts/vendor-container.ts",
    "test:pg": "CRESSLET_TEST_SCHEMA_PER_DATA_DIR=1 node --test --test-concurrency=1 \"tests/*_test.ts\"",
    "vendor:sdk": "node scripts/vendor-sdk.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "workerd": "^1.20261119.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "sql.js": "1.13.0",
    "typescript": "^7.0.2"
  }
}
