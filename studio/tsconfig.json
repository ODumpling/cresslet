{
  // The studio's page modules, served to browsers with their types stripped (server/static.ts).
  // server-worker.ts and start-service.ts run elsewhere: tsconfig.worker.json, tsconfig.service.json.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable", "dom.asynciterable"],
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "vendor/*.d.ts"],
  "exclude": ["server-worker.ts", "start-service.ts"]
}
